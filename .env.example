MONGODB_URI=mongodb://127.0.0.1:27017/rating_portal
SESSION_SECRET=replace-with-at-least-32-random-characters

# The Super Admin is seeded on the first connection if this email does not exist.
SUPER_ADMIN_EMAIL=Super-Admin-Mjaved@gmail.com
# Set the bootstrap password in .env.local / deployment secrets; never commit it.
SUPER_ADMIN_PASSWORD=

# Cloudinary is required for private proof, avatar, and ad-banner uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Generate a random 32-byte key and base64 encode it for encrypted payout details.
ENCRYPTION_KEY=

# Required for registration email verification, password reset, and withdrawal email codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
